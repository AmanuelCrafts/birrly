generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id          String     @id @default(uuid())
  telegramId  String     @unique
  username    String?
  firstName   String
  lastName    String?
  avatarUrl   String?
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([telegramId])
  @@map("users")
}
