generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id          String     @id @default(uuid())
  telegramId  String     @unique
  username    String?
  firstName   String
  lastName    String?
  avatarUrl   String?
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  currentVipPlanId String?
  currentVipPlan   VIPPlan? @relation("UserVipPlan", fields: [currentVipPlanId], references: [id])

  @@index([telegramId])
  @@map("users")
}

model VIPPlan {
  id                 String   @id @default(uuid())
  level              Int      @unique
  name               String
  depositAmount      Decimal  @db.Decimal(12, 2)
  dailyIncome        Decimal  @db.Decimal(12, 2)
  dailyTasksRequired Int
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users User[] @relation("UserVipPlan")

  @@index([level])
  @@index([isActive])
  @@map("vip_plans")
}
