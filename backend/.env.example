# ── Database (Neon Postgres) ─────────────────────────────
# Pooled connection (for serverless / Prisma Client)
DATABASE_URL="postgresql://user:password@ep-cool-name-region.aws.neon.tech/birrly?sslmode=require"
# Direct connection (for Prisma Migrate / DDL operations)
DIRECT_URL="postgresql://user:password@ep-cool-name-region.aws.neon.tech/birrly?sslmode=require"

# ── Telegram ──────────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=""

# ── Session ───────────────────────────────────────────────
# Generate a strong random string: openssl rand -hex 32
SESSION_SECRET=""

# ── App ───────────────────────────────────────────────────
NODE_ENV="development"
PORT="3001"
FRONTEND_URL="http://localhost:5173"
